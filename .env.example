# ===== iFlytek Spark (primary when configured) =====
SPARK_API_KEY=ak-REPLACE_ME
SPARK_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
SPARK_MODEL=spark-x2.6
# auto = 星火优先、DeepSeek 兜底；也可强制 spark / deepseek
LLM_PROVIDER=auto

# ===== DeepSeek (fallback model provider) =====
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 本地大模型（OpenAI 兼容，数据不出机，隐私优先）=====
# 默认指向 Ollama 的 OpenAI 兼容端点；可换 vLLM / LM Studio 等任意本地推理服务。
# 学生个人隐私数据场景走 privacy="local"，只调用本地提供方，绝不上云。
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
# 本地服务通常不校验密钥；留空则用占位，避免 ChatOpenAI 报错
LOCAL_LLM_API_KEY=

# ===== MySQL 8.0.21 (already running on this machine) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_ME
MYSQL_DB=qihang

# ===== DuckDB (analytics layer, MVP stand-in for ClickHouse) =====
DUCKDB_PATH=D:/qihang/data/analytics.duckdb

# ===== Web search (联网搜索，任选其一；都不配则引擎如实返回 configured=False) =====
# 优先级：serper > bing > bocha；博查国内可直连，key 形如 ak-xxx
# SERPER_API_KEY=REPLACE_ME
# BING_SEARCH_KEY=REPLACE_ME
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# BOCHA_API_KEY=REPLACE_ME

# ===== app =====
APP_PORT=8000
# 必须为至少 32 字符的非占位符随机值；缺失时服务拒绝启动
JWT_SECRET=REPLACE_WITH_32_RANDOM_CHARS
JWT_EXPIRE_MINUTES=120
# 本地演示账号统一口令（T001 / AI20230001 / AI20260001 等）
DEMO_PASSWORD=REPLACE_ME
# 临时公网演示才开启；只允许白名单账号通过共享口令登录，演示结束后关闭。
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_PASSWORD=123456h
PUBLIC_DEMO_ACCOUNTS=teacher:T001,student:AI20260001,student:AI20250001,student:AI20240004,student:AI20230001
# 仅答辩临时公网演示：明确允许 123456h 这类短口令；演示结束应关闭
PUBLIC_DEMO_ALLOW_WEAK_PASSWORD=true
LOG_LEVEL=INFO

# ===== 后台同步（0 表示关闭） =====
COMPETITION_SYNC_MINUTES=1440
RECRUIT_SYNC_HOURS=24
# 国考职位（《招考简章》年度数据）同步间隔；0 关闭
GUOKAO_SYNC_HOURS=24
# 浏览器 Web Push：VAPID 密钥与联系地址只从 .env 读取，禁止写进代码或 git。
# 未配置时通知中心仍可查看站内消息，但 Web Push 显示「未配置」。
# 本地生成密钥可用 py_vapid；部署时把公钥配置到下方，私钥保持仅服务端可见。
WEB_PUSH_PUBLIC_KEY=REPLACE_ME
WEB_PUSH_PRIVATE_KEY=REPLACE_ME
WEB_PUSH_CONTACT=mailto:admin@example.edu
WEB_PUSH_ENABLED=false
# 后台扫描未读通知并调用推送服务的间隔（分钟）；0 关闭
WEB_PUSH_INTERVAL_MINUTES=5
# 前端构建产物目录；留空 = 纯 API 模式（不托管静态页）
FRONTEND_DIST=web/dist
