# ===== iFlytek Spark (primary when configured) =====
SPARK_API_KEY=ak-REPLACE_ME
SPARK_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
SPARK_MODEL=spark-x2.6
# auto = 星火优先、DeepSeek 兜底；也可强制 spark / deepseek
LLM_PROVIDER=auto

# ===== DeepSeek (fallback model provider) =====
DEEPSEEK_API_KEY=sk-REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== MySQL 8.0.21 (already running on this machine) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_ME
MYSQL_DB=qihang

# ===== DuckDB (analytics layer, MVP stand-in for ClickHouse) =====
DUCKDB_PATH=D:/qihang/data/analytics.duckdb

# ===== Web search (联网搜索，任选其一；都不配则引擎如实返回 configured=False) =====
# 优先级：serper > bing > bocha；博查国内可直连，key 形如 ak-xxx
# SERPER_API_KEY=REPLACE_ME
# BING_SEARCH_KEY=REPLACE_ME
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# BOCHA_API_KEY=REPLACE_ME

# ===== app =====
APP_PORT=8000
JWT_SECRET=REPLACE_WITH_32_RANDOM_CHARS
JWT_EXPIRE_MINUTES=120
# 前端构建产物目录；留空 = 纯 API 模式（不托管静态页）
FRONTEND_DIST=web/dist